# --- Firebase (client — safe to expose, used by the browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server-only — NEVER prefix with NEXT_PUBLIC_) ---
# From your Firebase service account JSON (Project Settings > Service Accounts)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- AI ---
# Free-tier key from https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=
# Optional override, defaults to gemini-3.6-flash. Use gemini-3.5-flash-lite
# for a higher free daily request quota if you hit rate limits.
GEMINI_MODEL=

# How many raw documents /api/cron/daily analyzes per run (2 AI calls each).
# Defaults to 1 — gemini-3.6-flash's free tier is 5 requests/minute
# (confirmed from Google's own 429 response, see lib/ai/gemini.ts), and 2
# AI calls/doc + pacing between calls doesn't leave room for more inside
# Vercel Hobby's 60s function limit. Leftover documents roll over to the
# next day automatically. Raise this only once you're past that 60s limit
# (e.g. Vercel Pro) or running /api/cron/analyze separately on its own
# schedule.
DAILY_ANALYZE_BATCH_SIZE=

# --- Cron protection ---
# Set this in Vercel; Vercel Cron automatically sends it as a Bearer token.
# Leave unset locally to call the cron routes without auth during development.
CRON_SECRET=
